# Required for CV and opportunity intelligence.
OPENAI_API_KEY=

# API and persistence. These values are only used by the local development login.
STAGEVIVA_DB=stageviva.db
STAGEVIVA_AUTH_SECRET=replace-with-a-long-random-secret-in-production
STAGEVIVA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production with Lovable Cloud Auth / Supabase Auth.
# Setting the JWKS URL makes the API verify the user's Lovable session instead of
# issuing a second StageViva login. Set the issuer/audience when shown by Lovable.
STAGEVIVA_AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
STAGEVIVA_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
STAGEVIVA_AUTH_AUDIENCE=authenticated

# Optional: required only when sending queued email notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StageViva <notifications@your-domain.com>
